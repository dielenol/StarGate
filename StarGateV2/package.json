{
  "name": "stargatev2",
  "version": "1.0.0",
  "description": "Stargate TRPG 공식 랜딩 웹앱 - 세계관 소개, 프로젝트 소식, 이메일 문의 및 지원 접수",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1 --port 43849",
    "build": "pnpm --filter @stargate/shared-db build && pnpm --filter @stargate/core build && next build",
    "start": "next start --port 43849",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "dialogue:lint": "node --experimental-strip-types scripts/dialogue-review/cli.ts lint",
    "dialogue:review": "node --experimental-strip-types scripts/dialogue-review/cli.ts review",
    "dialogue:test": "node --experimental-strip-types --test scripts/dialogue-review/__tests__/*.test.mjs",
    "work-history:audit": "node scripts/audit-page-work-history.mjs",
    "work-history:test": "node --test scripts/__tests__/audit-page-work-history.test.mjs",
    "vtt-runtime:test": "node --experimental-strip-types --test lib/vtt-runtime/__tests__/*.test.mjs app/api/erp/admin/vtt-runtime/__tests__/*.test.mjs",
    "gallery:test": "node --experimental-strip-types --test lib/gallery/__tests__/*.test.mjs",
    "assets:audit": "node --experimental-strip-types scripts/audit-public-assets.mjs",
    "assets:test": "node --experimental-strip-types --test lib/assets/__tests__/*.test.mjs scripts/__tests__/audit-public-assets.test.mjs",
    "asset:path": "node --experimental-strip-types scripts/asset-path-cli.ts",
    "asset:publish": "node --experimental-strip-types scripts/publish-asset-cli.ts",
    "optimize:images": "node scripts/optimize-public-images.mjs",
    "db:ensure-indexes": "pnpm --filter @stargate/shared-db build && node --experimental-strip-types scripts/ensure-indexes.ts",
    "db:ensure-worker-indexes": "pnpm --filter @stargate/shared-db build && node --experimental-strip-types scripts/ensure-worker-indexes.ts",
    "db:preflight-worker-indexes": "pnpm --filter @stargate/shared-db build && node --experimental-strip-types scripts/preflight-worker-indexes.ts",
    "prelore:storage": "pnpm --filter @stargate/shared-db build",
    "lore:storage": "node --experimental-strip-types scripts/migrate-lore-storage.ts",
    "prelore:provenance": "pnpm --filter @stargate/shared-db build",
    "lore:provenance": "node --experimental-strip-types scripts/backfill-report-provenance.ts",
    "prelore:rebuild": "pnpm --filter @stargate/shared-db build",
    "lore:rebuild": "node --experimental-strip-types scripts/rebuild-lore-index.ts",
    "lore:test-projection": "node --experimental-strip-types --test scripts/lib/__tests__/lore-index-projection.test.mjs",
    "lore:baseline": "node --experimental-strip-types scripts/check-static-lore-baseline.ts",
    "preseed:factions": "pnpm --filter @stargate/shared-db build",
    "seed:factions": "node --experimental-strip-types scripts/seed-factions.ts",
    "preseed:institutions": "pnpm --filter @stargate/shared-db build",
    "seed:institutions": "node --experimental-strip-types scripts/seed-institutions.ts",
    "preseed:shop": "pnpm --filter @stargate/shared-db build",
    "seed:shop": "node --experimental-strip-types scripts/seed-shop-catalog.ts",
    "preseed:stocks": "pnpm --filter @stargate/shared-db build",
    "seed:stocks": "node --experimental-strip-types scripts/seed-stock-catalog.ts",
    "preseed:stock-history": "pnpm --filter @stargate/shared-db build",
    "seed:stock-history": "node --experimental-strip-types scripts/seed-stock-history.ts",
    "preseed:payload": "pnpm --filter @stargate/shared-db build",
    "seed:payload": "node --experimental-strip-types scripts/upsert-seed-payload.ts",
    "premigrate:character-sheet": "pnpm --filter @stargate/shared-db build",
    "migrate:character-sheet": "node --experimental-strip-types scripts/migrate-character-sheet-to-lore-play.ts",
    "premigrate:credit-balances": "pnpm --filter @stargate/shared-db build",
    "migrate:credit-balances": "node --experimental-strip-types scripts/migrate-credit-balances.ts",
    "migrate:character-equipment": "node --experimental-strip-types scripts/migrate-character-equipment-to-inventory.ts",
    "migrate:character-codename": "node --experimental-strip-types scripts/migrate-character-codename.ts",
    "migrate:neved-censor-3": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/migrate-neved-censor-3.ts",
    "migrate:towaski-license-renewals": "node --experimental-strip-types scripts/backfill-towaski-license-renewals.ts",
    "migrate:workshop-dm-outbox": "node --experimental-strip-types scripts/backfill-workshop-discord-dm-outbox.ts",
    "backfill:mrbeast-soda-stock-impact": "pnpm --filter @stargate/core build && node --env-file-if-exists=.env.local --experimental-strip-types scripts/backfill-mrbeast-soda-stock-impact.ts",
    "premigrate:novex-2": "pnpm --filter @stargate/shared-db build",
    "migrate:novex-2": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/migrate-novex-2.ts",
    "preschedule:starmart-capital": "pnpm --filter @stargate/shared-db build && pnpm --filter @stargate/core build",
    "schedule:starmart-capital": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/schedule-starmart-capital-scenario.ts",
    "sync:research-discord": "pnpm --filter @stargate/shared-db exec tsx ../../StarGateV2/scripts/sync-research-discord-cards.ts"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "keywords": [
    "nextjs",
    "landing-page",
    "stargate",
    "trpg"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@auth/core": "^0.41.0",
    "@stargate/core": "workspace:*",
    "@stargate/shared-db": "workspace:*",
    "@tanstack/react-query": "^5.99.0",
    "@vercel/blob": "^2.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "diff-match-patch": "^1.0.5",
    "mongodb": "^7.1.1",
    "next": "^16.1.6",
    "next-auth": "5.0.0-beta.30",
    "jose": "^6.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  }
}
