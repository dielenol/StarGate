DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
# Optional: 서브패스 배포 시에만 설정 (예: /StarGate)
NEXT_PUBLIC_APP_BASE_PATH=
# Optional: 메타 절대 URL 고정 (예: https://novus-ordo.vercel.app)
NEXT_PUBLIC_SITE_URL=

# --- Auth & ERP ---
# Auth.js secret (openssl rand -base64 32 로 생성)
AUTH_SECRET=
# Production URL for Auth.js redirects (예: https://novus-ordo.vercel.app)
AUTH_URL=
# StarGate V2 Discord OAuth (https://discord.com/developers/applications)
STARGATE_DISCORD_CLIENT_ID=
STARGATE_DISCORD_CLIENT_SECRET=
# Legacy local fallback only. Vercel에서는 STARGATE_* 사용 권장.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# MongoDB Atlas (기존 registra-bot과 동일 클러스터)
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Discord 서버(길드) ID — 세션 캘린더 등에서 사용
GUILD_ID=
# Discord bot token과 운영 webhook은 장기 실행 worker에만 둔다.

# --- Xeno research lab NPC chat (server-only) ---
# 미설정 시 자유대화는 고정 제노 대사로 안전하게 fallback한다.
OLLAMA_API_KEY=
OLLAMA_NPC_MODEL=qwen3.5:397b-cloud
# live index·master item 적재와 별도 승인 후에만 true.
# true여도 active worker heartbeat가 research-lab+RESEARCH_LAB_DM 준비를 증명해야 POST가 열린다.
RESEARCH_LAB_MUTATIONS_ENABLED=false

# --- Hall of Fame 2.0 writer gate (server-only) ---
# 인덱스·backfill 검증 및 별도 운영 승인 전에는 false를 유지한다.
# false이면 기존 연구/NOVEX 조회만 동작하고 새 공적 원장·분석 queue를 쓰지 않는다.
HALL_OF_FAME_V2_WRITES_ENABLED=false

# --- ERP realtime invalidation ---
# off: 기존 폴링만, observe: WebSocket+폴링, primary: 연결 중 폴링 중지.
REALTIME_CLIENT_MODE=off
# StarGateV2와 stargate-worker가 공유하는 32바이트 이상 HS256 secret.
REALTIME_TICKET_SECRET=
# worker Socket.IO 공개 주소 (예: https://realtime.ordonet.co.kr)
REALTIME_SOCKET_URL=
# worker 기본값과 맞춰야 한다. 특별한 이유가 없으면 변경하지 않는다.
REALTIME_TICKET_ISSUER=stargate-web
REALTIME_TICKET_AUDIENCE=stargate-worker

# --- Nochichim VTT runtime control (Vercel Production only, server-only) ---
# Preview/Development에서는 반드시 false 또는 미설정으로 유지한다.
NOCHICHIM_CONTROL_ENABLED=false
NOCHICHIM_CONTROL_URL=https://control.nochiijjim.com
# 앱 내부 health 토큰 및 기존 VTT 동기화 secret과 재사용하지 않는다.
NOCHICHIM_CONTROL_HMAC_SECRET=
NOCHICHIM_CONTROL_CF_ACCESS_CLIENT_ID=
NOCHICHIM_CONTROL_CF_ACCESS_CLIENT_SECRET=
# HOME↔VPS 전환 화면은 드라이런 후 Production에서만 별도로 켠다.
# true이면 위 legacy 단일 VPS 제어는 서버에서도 fail closed한다.
NOCHICHIM_HOST_CONTROL_ENABLED=false
NOCHICHIM_HOST_CONTROL_URL=https://control.nochiijjim.com
NOCHICHIM_HOST_CONTROL_HMAC_SECRET=
NOCHICHIM_HOST_CONTROL_CF_ACCESS_CLIENT_ID=
NOCHICHIM_HOST_CONTROL_CF_ACCESS_CLIENT_SECRET=
# 기존 캐릭터·인벤토리·작전 크레딧 동기화 전용. 위 제어 비밀값과 재사용 금지.
NOCHICHIM_SYNC_SECRET=

# --- Stock market ---
# Optional: 0/false/off 로 설정하면 매수·매도만 중지하고 시세 조회는 유지
STOCK_MARKET_ENABLED=1
# NOVEX 2.0 전환은 disabled → shadow(최소 7일) → enabled 순서로 별도 승인한다.
NOVEX_V2_MODE=disabled
# 수동 복구 route와 VTT 완료 감사 Cron Authorization: Bearer ${CRON_SECRET}
CRON_SECRET=
# 소다 판매량 backfill 검증 전에는 false로 유지하고, 완료 후 Web/worker에 함께 true로 설정한다.
MRBEAST_SODA_STOCK_IMPACT_TICK_ENABLED=false
# Scheduled stock market Discord webhook (server-only)
DISCORD_WEBHOOK_STOCK_URL=
DISCORD_WEBHOOK_STOCK_AVATAR_URL=
# Daily shop restock Discord webhook (server-only)
DISCORD_WEBHOOK_SHOP_URL=
DISCORD_WEBHOOK_SHOP_AVATAR_URL=
# Equipment research event Discord webhook (server-only)
DISCORD_WEBHOOK_RESEARCH_URL=
DISCORD_WEBHOOK_RESEARCH_AVATAR_URL=
# Optional: GM 공방 결과 이미지 업로드. 미설정 시 HTTPS URL 또는 /assets 경로 직접 입력만 사용합니다.
BLOB_READ_WRITE_TOKEN=
# Optional: 회원 전용 갤러리 팬아트용 private Vercel Blob store 토큰. 공용 store 토큰과 분리합니다.
GALLERY_BLOB_READ_WRITE_TOKEN=
