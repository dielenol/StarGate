DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
# Optional: 서브패스 배포 시에만 설정 (예: /StarGate)
NEXT_PUBLIC_APP_BASE_PATH=
# Optional: 메타 절대 URL 고정 (예: https://novus-ordo.vercel.app)
NEXT_PUBLIC_SITE_URL=

# --- Auth & ERP ---
# Auth.js secret (openssl rand -base64 32 로 생성)
AUTH_SECRET=
# Production URL for Auth.js redirects (예: https://novus-ordo.vercel.app)
AUTH_URL=
# StarGate V2 Discord OAuth (https://discord.com/developers/applications)
STARGATE_DISCORD_CLIENT_ID=
STARGATE_DISCORD_CLIENT_SECRET=
# Legacy local fallback only. Vercel에서는 STARGATE_* 사용 권장.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# MongoDB Atlas (기존 registra-bot과 동일 클러스터)
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Discord 서버(길드) ID — 세션 캘린더 등에서 사용
GUILD_ID=
# Discord 기본 봇 토큰. 범용 Discord API 호출의 폴백으로만 사용한다.
DISCORD_BOT_TOKEN=
# 공방 절차별 개인 DM 발신 전용 아메리 봇 토큰.
# 다른 봇 토큰으로 대체하지 않으며, Discord에 표시되는 발신 이름·프로필은
# 이 토큰이 속한 봇 계정(AMERI)의 설정을 따른다.
# 개인 DM은 ERP 계정에 Discord ID가 연결된 활성 사용자에게만 발송한다.
AMERI_DISCORD_BOT_TOKEN=
# 개인 거래 DM 발신 전용 레지스트라 봇 토큰.
# 다른 봇 토큰으로 대체하지 않으며, Discord에 표시되는 발신 이름·프로필은
# 이 토큰이 속한 봇 계정(REGISTRAR)의 설정을 따른다.
REGISTRAR_DISCORD_BOT_TOKEN=

# --- ERP realtime invalidation ---
# off: 기존 폴링만, observe: WebSocket+폴링, primary: 연결 중 폴링 중지.
REALTIME_CLIENT_MODE=off
# StarGateV2와 stargate-worker가 공유하는 32바이트 이상 HS256 secret.
REALTIME_TICKET_SECRET=
# worker Socket.IO 공개 주소 (예: https://realtime.ordonet.co.kr)
REALTIME_SOCKET_URL=
# worker 기본값과 맞춰야 한다. 특별한 이유가 없으면 변경하지 않는다.
REALTIME_TICKET_ISSUER=stargate-web
REALTIME_TICKET_AUDIENCE=stargate-worker

# --- Stock market ---
# Optional: 0/false/off 로 설정하면 매수·매도만 중지하고 시세 조회는 유지
STOCK_MARKET_ENABLED=1
# Vercel Cron Authorization: Bearer ${CRON_SECRET}
CRON_SECRET=
# Legacy owner switches. Leave enabled until each matching worker job has
# passed its cutover gate; disable independently to prevent dual ownership.
LEGACY_CRON_STOCKS_ENABLED=true
LEGACY_CRON_DAILY_ALLOWANCE_ENABLED=true
# Vercel Hobby의 제한을 피하기 위해 공방 READY DM을 5분마다 drain하는
# Dokploy Schedule 전용 Authorization secret.
WORKSHOP_DM_CRON_SECRET=
# Scheduled stock market Discord webhook (server-only)
DISCORD_WEBHOOK_STOCK_URL=
# Daily shop restock Discord webhook (server-only)
DISCORD_WEBHOOK_SHOP_URL=
# --- Limited MrBeast soda lottery (all four values required; UTC ISO window) ---
# Safe default is disabled. Enabling without eventId/start/end remains disabled.
MRBEAST_LOTTERY_ENABLED=false
MRBEAST_LOTTERY_EVENT_ID=
MRBEAST_LOTTERY_START_AT=
MRBEAST_LOTTERY_END_AT=
# Character edit and GM admin audit Discord webhook (server-only)
DISCORD_WEBHOOK_CHAR_EDIT_URL=
# Optional legacy fallback for player self-edit alerts.
# Prefer DISCORD_WEBHOOK_CHAR_EDIT_URL so admin/player edit alerts land in one audit channel.
DISCORD_WEBHOOK_CHAR_SELF_EDIT_URL=
# Equipment research event Discord webhook (server-only)
DISCORD_WEBHOOK_RESEARCH_URL=
# Optional: GM 공방 결과 이미지 업로드. 미설정 시 HTTPS URL 또는 /assets 경로 직접 입력만 사용합니다.
BLOB_READ_WRITE_TOKEN=
