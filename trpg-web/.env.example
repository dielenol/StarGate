MONGODB_URI=mongodb+srv://...
AUTH_URL=http://localhost:3000
AUTH_SECRET=
TRPG_DISCORD_CLIENT_ID=
TRPG_DISCORD_CLIENT_SECRET=
# Legacy local fallback only. Vercel에서는 TRPG_* 사용 권장.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
TRPG_GUILD_ID=

# Google Calendar 개인 일정 오버레이 (선택 기능)
# Google Cloud 웹 OAuth 콜백: ${AUTH_URL}/api/integrations/google-calendar/callback
# Calendar API·동의 화면·테스트 사용자·개인정보처리방침 준비 후 true로 전환.
# readonly 민감 범위 2개를 사용하므로 공개 전 Google 검증 요건을 확인한다.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# `openssl rand -base64 32` 등으로 생성한 전용 32바이트 AES 키
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
