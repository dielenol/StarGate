# Discord Bot Token (Discord Developer Portal > Applications > Bot)
DISCORD_TOKEN=your_bot_token_here

# Discord Application (Client) ID
DISCORD_CLIENT_ID=your_client_id_here

# MongoDB Atlas connection string
# trpg-web과 같은 stargate 통합 DB를 바라보게 설정
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/stargate?retryWrites=true&w=majority
# MONGODB_DB_NAME=stargate

# 개발 중 슬래시 커맨드를 특정 길드에만 즉시 등록할 때 사용
# 운영에서는 봇 프로필에 명령어가 노출되도록 비워 두고 전역 등록
# GUILD_ID=your_trpg_guild_id_here

# trpg-bot 운영 길드 ID (필수)
TRPG_GUILD_ID=your_trpg_guild_id_here

# DM 실패 시 같은 내용을 멘션으로 보내는 폴백 텍스트 채널 ID (필수)
TRPG_FALLBACK_CHANNEL_ID=your_fallback_text_channel_id_here

# 음악 기능 사용 시 명령과 단일 상태판을 표시하는 일반 텍스트 채널 ID (필수)
TRPG_MUSIC_CHANNEL_ID=your_music_text_channel_id_here

# 운영 장애 DM을 받을 사용자 ID (권장)
# Discord 개발자 모드에서 본인 우클릭 > 사용자 ID 복사
TRPG_ALERT_USER_ID=your_discord_user_id_here

# 운영 장애를 상태판과 분리된 새 메시지로도 남길 일반 텍스트 채널 ID (선택)
# 미설정 시 DM만 전송
# TRPG_ALERT_CHANNEL_ID=your_alert_text_channel_id_here

# trpg-web 운영 URL (필수)
TRPG_WEB_BASE_URL=https://dache-calender.vercel.app

# trpg-web 세션 생성/수정/취소 알림 폴링 주기(ms). 기본 60000
# TRPG_POLLING_INTERVAL_MS=60000

# 24시간 전 리마인드 폴링 주기(ms). 기본 300000
# TRPG_REMINDER_INTERVAL_MS=300000

# /세션확인 캘린더 PNG 렌더링(Puppeteer). 끄려면 0 / false / off
# RESULT_CARD_IMAGE=1

# 로컬/PM2에서 기본 PATH 외 실행파일을 사용할 때만 지정 (Docker에는 내장)
# YT_DLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# YouTube player client 목록. 기본값 visionos (2026-08-18 실측 정상 클라이언트).
# 재생이 HTTP 403으로 막히면 배포 없이 이 값만 바꿔 재기동해 우회할 수 있다.
# YT_DLP_PLAYER_CLIENTS=visionos

# bgutil POT provider HTTP 주소. Docker 이미지는 provider를 내장하고 이 값을
# http://127.0.0.1:4416 으로 이미 설정한다. 외부 provider를 쓸 때만 재정의.
# YT_DLP_POT_PROVIDER_URL=http://bgutil-provider:4416

# 내장 POT provider를 띄우지 않으려면 1. (메모리 절약용, PO token 없이 동작)
# POT_PROVIDER_DISABLED=1
