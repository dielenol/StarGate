WORKER_MODE=shadow
# 주식 엔진 전환 모드. live 변경은 DB migration·cron 변경과 분리 승인한다.
NOVEX_V2_MODE=disabled
WORKER_REPLICA_COUNT=1
WORKER_HOST=0.0.0.0
WORKER_PORT=3001
WORKER_POLL_INTERVAL_MS=30000
# production active는 등록된 domain consumer 전체를 빠짐없이 구성한다.
WORKER_CONSUMERS=all
# 제노 연구소 worker mutation은 index·catalog 적재와 별도로 승인한 뒤에만 true로 전환한다.
# active heartbeat는 이 값과 실제 WORKER_CONSUMERS 포함 여부를 Web readiness에 함께 광고한다.
RESEARCH_LAB_WORKER_ENABLED=false
# 명예의 전당 원장 작성·Cloud 작전 공적 분석은 index/backfill 검증 뒤 별도 승인한다.
HALL_OF_FAME_V2_WRITES_ENABLED=false
# gate=true일 때만 필수. U 공개 작전보고서만 외부 분석 대상으로 보낸다.
OLLAMA_API_KEY=
HALL_OF_FAME_OLLAMA_API_URL=https://ollama.com/api/chat
HALL_OF_FAME_PROPOSER_MODEL=qwen3.5:397b
HALL_OF_FAME_CRITIC_MODEL=gpt-oss:120b
HALL_OF_FAME_OLLAMA_TIMEOUT_MS=60000
# staging에서 순차 검증할 때만 true. production에서는 false 유지.
WORKER_CONSUMERS_ALLOW_PARTIAL=false
# active 모드는 전체 outbox를 소비해야 하며 부분 opt-in을 허용하지 않는다.
WORKER_OUTBOX_KINDS=all
# staging에서 한 kind만 검증할 때만 true. production에서는 false 유지.
WORKER_OUTBOX_ALLOW_PARTIAL=false
# 소다 판매량 backfill 검증 전에는 false, 완료 후 Web과 함께 true.
MRBEAST_SODA_STOCK_IMPACT_TICK_ENABLED=false

MONGODB_URI=
MONGODB_DB_NAME=stargate
MONGODB_MAX_POOL_SIZE=10

REALTIME_TICKET_SECRET=
REALTIME_TICKET_ISSUER=stargate-web
REALTIME_TICKET_AUDIENCE=stargate-worker
REALTIME_ALLOWED_ORIGINS=https://www.ordonet.co.kr
REALTIME_MAX_PAYLOAD_BYTES=65536
REALTIME_MAX_CONNECTIONS=500
REALTIME_MAX_CONNECTIONS_PER_USER=5

NEXT_PUBLIC_SITE_URL=https://www.ordonet.co.kr
AMERI_DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_RESEARCH_URL=
DISCORD_WEBHOOK_RESEARCH_AVATAR_URL=
DISCORD_WEBHOOK_STOCK_URL=
DISCORD_WEBHOOK_STOCK_AVATAR_URL=
DISCORD_WEBHOOK_AUDIT_URL=
# WORKFLOW와 OPS는 서로 다른 전용 webhook이 필수이며 다른 채널로 fallback하지 않는다.
DISCORD_WEBHOOK_WORKFLOW_URL=
DISCORD_WEBHOOK_OPS_URL=
DISCORD_WEBHOOK_SHOP_URL=
DISCORD_WEBHOOK_SHOP_AVATAR_URL=
REGISTRAR_DISCORD_BOT_TOKEN=
